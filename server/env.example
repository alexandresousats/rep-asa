DATABASE_URL=postgresql://asa:asa@localhost:5433/asa
PORT=4000

# Cookie de sessão (asa_session / asa_workspace).
# Com NODE_ENV=production o cookie sai com Secure por padrão.
# COOKIE_SECURE=1 força Secure também em desenvolvimento.
# COOKIE_SECURE=0 desliga Secure (somente para desenvolvimento local, sem HTTPS).
# COOKIE_SECURE=

# Validade do link público de demanda.
# Número em segundos (ex.: 604800) ou duração com sufixo s, m, h, d (ex.: 7d, 12h).
# Padrão: 7 dias. Valores acima de 30 dias ficam limitados a 30 dias.
# DEMAND_LINK_TTL=7d

# Dodo Payments — plano mensal único.
# Crie um produto de assinatura mensal no modo de teste e copie o id (pdt_...).
# A chave e o segredo do webhook ficam em Developer no dashboard.
# DODO_PAYMENTS_API_KEY=
# DODO_PAYMENTS_WEBHOOK_KEY=
# DODO_PAYMENTS_PRODUCT_ID=
# Produto trimestral (a cada 3 meses). Opcional até existir no Dodo.
# DODO_PAYMENTS_PRODUCT_ID_QUARTER=
# Add-ons de vaga. Avulso e combo podem estar juntos na mesma assinatura.
# DODO_PAYMENTS_ADDON_SEAT_MONTH=
# DODO_PAYMENTS_ADDON_SEAT_QUARTER=
# DODO_PAYMENTS_ADDON_PACK_MONTH=
# DODO_PAYMENTS_ADDON_PACK_QUARTER=
# test_mode ou live_mode. Qualquer outro valor usa o modo de teste.
# DODO_PAYMENTS_ENVIRONMENT=test_mode
# URL pública deste app. O webhook fica em {APP_URL}/api/webhooks/dodo
# APP_URL=https://openasa.cloud

# E-mail de confirmação de conta e de redefinição de senha.
# Sem SMTP_URL o servidor só escreve a mensagem no log.
# SMTP_URL=smtp://usuario:senha@smtp.exemplo.com:587
# MAIL_FROM=ASA <noreply@openasa.cloud>
# Destino dos pedidos de suporte (ticket, bug e suporte técnico).
# SUPPORT_EMAIL=suporte@openasa.cloud

# Login e cadastro com Google. Cadastre este redirect no console do Google:
# {APP_URL}/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# O botão do app usa o Firebase (projeto openasa-login). Opcional, se quiser trocar a chave.
# FIREBASE_API_KEY=
# DODO_PAYMENTS_RETURN_URL=https://openasa.cloud/configuracoes?tab=assinatura
