DATABASE_URL=postgresql://asa:asa@localhost:5433/asa
PORT=4000

# Cookie de sessão (asa_session / asa_workspace).
# Com NODE_ENV=production o cookie sai com Secure por padrão.
# COOKIE_SECURE=1 força Secure também em desenvolvimento.
# COOKIE_SECURE=0 desliga Secure (somente para desenvolvimento local, sem HTTPS).
# COOKIE_SECURE=

# Validade do link público de demanda.
# Número em segundos (ex.: 604800) ou duração com sufixo s, m, h, d (ex.: 7d, 12h).
# Padrão: 7 dias. Valores acima de 30 dias ficam limitados a 30 dias.
# DEMAND_LINK_TTL=7d
