generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccessLevel {
  admin
  editor
  leitura
  cliente
}

enum ApprovalStatus {
  none
  pending
  approved
  changes_requested
}

enum MemberStatus {
  pending
  active
}

enum Priority {
  baixa
  media
  alta
  urgente
}

enum TaskStatus {
  todo
  doing
  done
}

enum BillingStatus {
  pending
  active
  past_due
  on_hold
  paused
  cancelled
  failed
  expired
}

enum BillingPeriod {
  month
  quarter
}

model User {
  id              String       @id
  firstName       String
  lastName        String       @default("")
  name            String
  email           String       @unique
  passwordHash    String?
  phone           String?
  emailVerifiedAt DateTime?
  initials        String
  role            String
  access          AccessLevel
  avatar          String?      @db.Text
  master          Boolean      @default(false)
  createdAt       DateTime     @default(now())

  sessions         Session[]
  resetTokens      ResetToken[]
  emailTokens      EmailToken[]
  identities       AuthIdentity[]
  ownedProjects    Project[]           @relation("ProjectOwner")
  memberships      ProjectMember[]
  workspaceMembers WorkspaceMember[]   @relation("WorkspaceMembers")
  sentInvites      WorkspaceMember[]   @relation("InvitedBy")
  assignedTasks    Task[]              @relation("Assignee")
  approvedTasks    Task[]              @relation("TaskApprover")
  comments         Comment[]
  messages         Message[]
  threads          ThreadParticipant[]
  notifications    Notification[]
  apiKeys          ApiKey[]
  taskFollows      TaskFollower[]
  paidSubscriptions WorkspaceSubscription[]
  supportRequests  SupportRequest[]
  shareLinksCreated ClientShareLink[] @relation("ShareLinkCreator")
}

model Workspace {
  id           String   @id
  name         String
  logo         String?  @db.Text
  agentBaseUrl String?
  agentModel   String?
  agentApiKey  String?  @db.Text
  createdAt    DateTime @default(now())

  members       WorkspaceMember[]
  projects      Project[]
  tags          Tag[]
  threads       Thread[]
  notifications Notification[]
  apiKeys       ApiKey[]
  subscription  WorkspaceSubscription?
  supportRequests SupportRequest[]
  shareLinks    ClientShareLink[]
}

model WorkspaceMember {
  workspaceId String
  userId      String
  access      AccessLevel
  status      MemberStatus @default(pending)
  role        String
  owner       Boolean      @default(false)
  invitedById String?
  createdAt   DateTime     @default(now())
  acceptedAt  DateTime?
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User         @relation("WorkspaceMembers", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy   User?        @relation("InvitedBy", fields: [invitedById], references: [id])

  @@id([workspaceId, userId])
  @@index([userId])
}

model Session {
  id        String   @id
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ResetToken {
  id        String   @id
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailToken {
  id        String   @id
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthIdentity {
  id         String   @id
  userId     String
  provider   String
  providerId String
  email      String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

model LoginAttempt {
  id        String   @id
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model Project {
  id          String    @id
  name        String
  color       String
  description String    @db.Text
  ownerId     String
  workspaceId String
  createdAt   String
  owner       User      @relation("ProjectOwner", fields: [ownerId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  sections    Section[]
  tasks       Task[]
  threads     Thread[]
  shareLinks  ClientShareLink[]

  @@index([workspaceId])
}

model ProjectMember {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Section {
  id        String  @id
  projectId String
  name      String
  position  Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
}

model Task {
  id          String     @id
  projectId   String
  title       String
  description String     @default("") @db.Text
  assigneeId  String?
  dueDate     String?
  startDate   String?
  priority    Priority   @default(media)
  status      TaskStatus @default(todo)
  section     String
  order       Int        @default(0)
  parentId     String?
  completedAt  String?
  createdAt    String
  updatedAt    String?
  externalId   String?
  customFields Json?
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee     User?      @relation("Assignee", fields: [assigneeId], references: [id])
  parent       Task?      @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  children     Task[]     @relation("Subtasks")
  blockedByEdges TaskDependency[] @relation("BlockedTask")
  blockingEdges  TaskDependency[] @relation("BlockerTask")
  tags         TaskTag[]
  comments    Comment[]
  followers        TaskFollower[]
  attachments      Attachment[]
  isDemand         Boolean        @default(false)
  demandFormat     String?
  referenceUrls    String?        @db.Text
  approvalStatus   ApprovalStatus @default(none)
  approvalFeedback String?        @db.Text
  approvedAt       String?
  approvedById     String?
  approvedBy       User?          @relation("TaskApprover", fields: [approvedById], references: [id])
  approvedByClientName String?
  clientFeedback   ClientFeedback[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([approvalStatus])
  @@index([externalId])
}

model TaskDependency {
  blockerId String
  blockedId String
  blocker   Task @relation("BlockerTask", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   Task @relation("BlockedTask", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model Tag {
  id          String    @id
  name        String
  color       String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       TaskTag[]

  @@index([workspaceId])
}

model TaskTag {
  taskId String
  tagId  String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model Comment {
  id        String @id
  taskId    String
  authorId  String
  body      String @db.Text
  createdAt String
  task      Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User   @relation(fields: [authorId], references: [id])

  @@index([taskId])
}

model TaskFollower {
  taskId String
  userId String
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model Attachment {
  id        String   @id
  taskId    String
  name      String
  mime      String
  size      Int
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Thread {
  id            String    @id
  title         String
  projectId     String?
  workspaceId   String
  lastMessageAt String
  project       Project?  @relation(fields: [projectId], references: [id])
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  participants  ThreadParticipant[]
  messages      Message[]

  @@index([workspaceId])
}

model ThreadParticipant {
  threadId String
  userId   String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([threadId, userId])
  @@index([userId])
}

model Message {
  id        String @id
  threadId  String
  authorId  String
  body      String @db.Text
  createdAt String
  thread    Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User   @relation(fields: [authorId], references: [id])

  @@index([threadId])
}

model Notification {
  id          String     @id
  userId      String
  workspaceId String?
  type        String
  title       String
  body        String
  href        String?
  readAt      DateTime?
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model WorkspaceSubscription {
  workspaceId        String        @id
  payerUserId        String?
  dodoCustomerId     String?
  dodoSubscriptionId String?       @unique
  productId          String?
  status             BillingStatus @default(pending)
  billingPeriod      BillingPeriod @default(month)
  extraSeats         Int           @default(0)
  seatPacks          Int           @default(0)
  cancelAtPeriodEnd  Boolean       @default(false)
  currentPeriodEnd   DateTime?
  sourceUpdatedAt    DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  workspace          Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payer              User?         @relation(fields: [payerUserId], references: [id], onDelete: SetNull)

  @@index([dodoCustomerId])
  @@index([payerUserId])
}

model WebhookDelivery {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

model BillingCheckout {
  id          String   @id
  sessionId   String   @unique
  workspaceId String
  userId      String
  createdAt   DateTime @default(now())

  @@index([workspaceId])
}

enum SupportKind {
  ticket
  bug
  tecnico
}

model SupportRequest {
  id          String      @id
  userId      String
  workspaceId String?
  kind        SupportKind
  subject     String
  body        String
  page        String?
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workspaceId])
}

enum ShareVisibility {
  public
  private
}

model ClientShareLink {
  id             String          @id
  projectId      String
  workspaceId    String
  tokenHash      String          @unique
  label          String          @default("")
  createdById    String
  createdAt      DateTime        @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  lastAccessAt   DateTime?
  accessCount    Int             @default(0)
  visibility     ShareVisibility @default(public)
  pinHash        String?
  sessionVersion Int             @default(0)
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy      User            @relation("ShareLinkCreator", fields: [createdById], references: [id])
  feedback       ClientFeedback[]

  @@index([projectId])
  @@index([workspaceId])
}

enum ClientFeedbackKind {
  approved
  changes_requested
}

// Aprovação ou pedido de ajuste feito pelo cliente no link, que não é um usuário do app.
model ClientFeedback {
  id          String             @id
  taskId      String
  shareLinkId String?
  kind        ClientFeedbackKind
  clientName  String
  clientEmail String?
  message     String?            @db.Text
  createdAt   DateTime           @default(now())
  task        Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  shareLink   ClientShareLink?   @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([shareLinkId])
}

model ApiKey {
  id          String     @id
  userId      String
  name        String
  keyHash     String     @unique
  prefix      String
  workspaceId String?
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
}
