generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccessLevel {
  admin
  editor
  leitura
  cliente
}

enum ApprovalStatus {
  none
  pending
  approved
  changes_requested
}

enum MemberStatus {
  pending
  active
}

enum Priority {
  baixa
  media
  alta
  urgente
}

enum TaskStatus {
  todo
  doing
  done
}

model User {
  id           String      @id
  name         String
  email        String      @unique
  passwordHash String
  initials     String
  role         String
  access       AccessLevel
  avatar       String?     @db.Text
  master       Boolean     @default(false)
  createdAt    DateTime    @default(now())

  sessions         Session[]
  resetTokens      ResetToken[]
  ownedProjects    Project[]           @relation("ProjectOwner")
  memberships      ProjectMember[]
  workspaceMembers WorkspaceMember[]   @relation("WorkspaceMembers")
  sentInvites      WorkspaceMember[]   @relation("InvitedBy")
  assignedTasks    Task[]              @relation("Assignee")
  approvedTasks    Task[]              @relation("TaskApprover")
  comments         Comment[]
  messages         Message[]
  threads          ThreadParticipant[]
  notifications    Notification[]
  apiKeys          ApiKey[]
  taskFollows      TaskFollower[]
}

model Workspace {
  id        String   @id
  name      String
  createdAt DateTime @default(now())

  members       WorkspaceMember[]
  projects      Project[]
  tags          Tag[]
  threads       Thread[]
  notifications Notification[]
  apiKeys       ApiKey[]
}

model WorkspaceMember {
  workspaceId String
  userId      String
  access      AccessLevel
  status      MemberStatus @default(pending)
  role        String
  owner       Boolean      @default(false)
  invitedById String?
  createdAt   DateTime     @default(now())
  acceptedAt  DateTime?
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User         @relation("WorkspaceMembers", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy   User?        @relation("InvitedBy", fields: [invitedById], references: [id])

  @@id([workspaceId, userId])
  @@index([userId])
}

model Session {
  id        String   @id
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ResetToken {
  id        String   @id
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id        String   @id
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model Project {
  id          String    @id
  name        String
  color       String
  description String    @db.Text
  ownerId     String
  workspaceId String
  createdAt   String
  owner       User      @relation("ProjectOwner", fields: [ownerId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  sections    Section[]
  tasks       Task[]
  threads     Thread[]

  @@index([workspaceId])
}

model ProjectMember {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Section {
  id        String  @id
  projectId String
  name      String
  position  Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
}

model Task {
  id          String     @id
  projectId   String
  title       String
  description String     @default("") @db.Text
  assigneeId  String?
  dueDate     String?
  startDate   String?
  priority    Priority   @default(media)
  status      TaskStatus @default(todo)
  section     String
  order       Int        @default(0)
  parentId    String?
  completedAt String?
  createdAt   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?      @relation("Assignee", fields: [assigneeId], references: [id])
  parent      Task?      @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  children    Task[]     @relation("Subtasks")
  tags        TaskTag[]
  comments    Comment[]
  followers        TaskFollower[]
  attachments      Attachment[]
  isDemand         Boolean        @default(false)
  demandFormat     String?
  referenceUrls    String?        @db.Text
  approvalStatus   ApprovalStatus @default(none)
  approvalFeedback String?        @db.Text
  approvedAt       String?
  approvedById     String?
  approvedBy       User?          @relation("TaskApprover", fields: [approvedById], references: [id])

  @@index([projectId])
  @@index([assigneeId])
  @@index([approvalStatus])
}

model Tag {
  id          String    @id
  name        String
  color       String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       TaskTag[]

  @@index([workspaceId])
}

model TaskTag {
  taskId String
  tagId  String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model Comment {
  id        String @id
  taskId    String
  authorId  String
  body      String @db.Text
  createdAt String
  task      Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User   @relation(fields: [authorId], references: [id])

  @@index([taskId])
}

model TaskFollower {
  taskId String
  userId String
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model Attachment {
  id        String   @id
  taskId    String
  name      String
  mime      String
  size      Int
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Thread {
  id            String    @id
  title         String
  projectId     String?
  workspaceId   String
  lastMessageAt String
  project       Project?  @relation(fields: [projectId], references: [id])
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  participants  ThreadParticipant[]
  messages      Message[]

  @@index([workspaceId])
}

model ThreadParticipant {
  threadId String
  userId   String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([threadId, userId])
  @@index([userId])
}

model Message {
  id        String @id
  threadId  String
  authorId  String
  body      String @db.Text
  createdAt String
  thread    Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User   @relation(fields: [authorId], references: [id])

  @@index([threadId])
}

model Notification {
  id          String     @id
  userId      String
  workspaceId String?
  type        String
  title       String
  body        String
  href        String?
  readAt      DateTime?
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model ApiKey {
  id          String     @id
  userId      String
  name        String
  keyHash     String     @unique
  prefix      String
  workspaceId String?
  lastUsedAt  DateTime?
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
}
